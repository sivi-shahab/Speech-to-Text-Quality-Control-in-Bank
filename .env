# =================================================================
# Speech STT Service — .env PRODUCTION
# Disusun dari .env lama Anda + fix bug yang ditemukan + var baru
# hasil refactor (semua default AMAN, tidak mengaktifkan apa pun
# kecuali diubah eksplisit).
# =================================================================

PORT=8000

# [FIXED] Sebelumnya 524288000 (nilai byte, bukan MB — komentar asli
# kode: "MAX_FILE_SIZE dalam MB"). 500 = 500MB, sesuai maksud aslinya.
MAX_FILE_SIZE=500

MODEL_WHISPER=large-v3
URL_SAVE_DB=http://localhost:8010/upload-pdf/
MAIN_BACKEND_RESULT_URL=http://10.158.32.26:4000/webhook/register_stt_result

# WAJIB diisi kalau pakai endpoint /speech/stt/save_dashboard
# (belum ada di .env lama Anda — isi kalau endpoint itu dipakai)
API_KEY=

HF_TOKEN=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

CORS_ORIGINS=http://localhost:3000,https://dashboard-vctx.bankmega.local/,http://10.158.32.26:4006
DEPLOYMENT_MODE=prod
TMPDIR=/data/tmp

# =================================================================
# DATABASE — [FIXED] services/db.py butuh SATU connection string
# DATABASE_URL, bukan DB_HOST/DB_PORT/dst terpisah. Dikonstruksi dari
# nilai DB_* lama Anda, password sudah di-percent-encode dengan benar
# (karakter '@' dan '!' di password Anda WAJIB di-encode di URL,
# kalau tidak parsing DATABASE_URL akan salah/gagal).
#
# DB_HOST=10.155.32.17  DB_PORT=5432  DB_NAME=da
# DB_USER=datamgmt      DB_PASS=D@t44mgmt!123 (sudah di-encode di bawah)
# =================================================================
DATABASE_URL=postgresql://datamgmt:D%40t44mgmt%21123@10.155.32.17:5432/da

# =================================================================
# UPLOAD & JOB QUEUE
# =================================================================
MAX_UPLOAD_SIZE_MB=1000
MAX_PENDING_JOBS=200
MAX_TRANSCRIBE_WORKERS=50




# .env STT service
MAIN_BACKEND_BASE_URL=http://10.158.32.26:4000
MAIN_BACKEND_API_KEY=sk-d37bb40794a34bb1f493ab451d3d8057a755433f37cc66057e94c439b0e323b0
DEFAULT_UPLOAD_TRANSCRIPT_CAMPAIGN=Cashline

# =================================================================
# DSP: fraud & gender detection
# =================================================================
DSP_FRAUD_ENABLED=false
DSP_FRAUD_STD_HZ=90
DSP_FRAUD_JUMP_HZ=90
DSP_FRAUD_COOLDOWN_SEGS=10

# [PERLU DIKONFIRMASI] Sebelumnya didefinisikan 2x (15 lalu 60) di
# .env lama — env var duplikat, yang TERAKHIR yang menang (60).
# Saya pakai 60 karena itu yang efektif jalan sebelumnya. Ganti ke 15
# kalau ternyata yang Anda maksud window lebih ketat.
DSP_FRAUD_JUMP_WINDOW_SEC=60

DSP_FEMALE_THRESHOLD_HZ=185.0
DSP_MALE_THRESHOLD_HZ=155.0
DSP_HIGHPASS_HZ=140.0
DSP_MIN_VOICED_FRAMES=5
DSP_FRAUD_MIN_DUR_SEC=1.5
DSP_FMIN_HZ=65.0
DSP_FMAX_HZ=300.0

# =================================================================
# DRC: dynamic range compression
# =================================================================
DRC_ENABLED=true
DRC_TARGET_DB=-15
DRC_MAX_GAIN_DB=40
DRC_FRAME_MS=50.0
DRC_HOP_MS=25.0
DRC_MIN_GAIN_DB=-20.0
DRC_ATTACK_MS=10.0
DRC_RELEASE_MS=50.0

# =================================================================
# Label speaker final (PDF report, dst)
# =================================================================
AGENT_SPEAKER_LABEL=Agent
CUSTOMER_SPEAKER_LABEL=Customer

# =================================================================
# ASR BACKEND — whisper (default, TIDAK BERUBAH dari sebelumnya) | elevenlabs
# =================================================================
ASR_BACKEND=elevenlabs

ELEVENLABS_API_KEY=sk_0869a50c5f3db09a6d158ebae83bbd42ecd3ee694ab90f5d
ELEVENLABS_MODEL_ID=scribe_v2
ELEVENLABS_NUM_SPEAKERS=2
ELEVENLABS_TAG_AUDIO_EVENTS=false
ELEVENLABS_KEYTERMS=Cashline,Mega Ultima Shield,Provisi
ELEVENLABS_REQUEST_TIMEOUT_SEC=300

# =================================================================
# DIARIZATION BACKEND — pyannote (default, TIDAK BERUBAH) | nemo
# =================================================================
DIARIZATION_BACKEND=pyannote

PYANNOTE_ENABLE_TELEPHONY_TUNING=true
PYANNOTE_MIN_CLUSTER_SIZE=6
PYANNOTE_SEGMENTATION_MIN_DURATION_OFF=0.1
PYANNOTE_CLUSTERING_THRESHOLD=
DIARIZATION_MIN_AUDIO_DURATION_SEC=15.0

NEMO_DIARIZER_MODEL_NAME=diar_msdd_telephonic
NEMO_DIARIZER_CONFIG_PATH=
NEMO_DIARIZER_VAD_MODEL=vad_multilingual_marblenet
NEMO_DIARIZER_SPEAKER_MODEL=titanet_large
NEMO_DIARIZER_WORK_DIR=/data/tmp/nemo_diarizer
NEMO_DIARIZER_FRESH_INSTANCE_PER_CALL=false

# =================================================================
# BELUM DIPAKAI kode manapun di hasil refactor — konfirmasi ke saya
# kalau ini masih dibutuhkan untuk komponen lain di luar service ini:
# REDIS_URL=redis://localhost:6379/0
# DIARIZATION_NUM_SPEAKERS=2   (num_speakers di-hardcode 2 di engine.py)
# =================================================================
